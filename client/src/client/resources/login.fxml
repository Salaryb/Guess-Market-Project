<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controllers.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <Label styleClass="main-title" text="Guess Market" />
   <Label styleClass="status-label" text="Enter a unique user name to log in" />
   <TextField fx:id="userNameField" maxWidth="320.0" onAction="#onLogin" promptText="User name" />
   <Button fx:id="loginButton" defaultButton="true" onAction="#onLogin" styleClass="action-button" text="Login" />
   <Label fx:id="errorLabel" maxWidth="420.0" styleClass="error-label" wrapText="true" />
</VBox>
