<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controllers.ChatController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <Label styleClass="section-title" text="Chat - everyone logged in sees all messages" />
   <ListView fx:id="chatList" VBox.vgrow="ALWAYS" />
   <HBox spacing="8.0">
      <TextField fx:id="messageField" onAction="#onSend" promptText="Write a message..." HBox.hgrow="ALWAYS" />
      <Button fx:id="sendButton" onAction="#onSend" styleClass="action-button" text="Send" />
   </HBox>
</VBox>
